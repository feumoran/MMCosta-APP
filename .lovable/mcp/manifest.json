{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ydytrnyvxbofzsjqpvrw.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "mmcosta-flow",
      "version": "0.1.0",
      "title": "MMcosta Flow"
    },
    "tools": [
      {
        "name": "listar_obras",
        "title": "Consultar obras",
        "description": "Lista até 100 obras ativas permitidas ao usuário, com identificação, status e datas, sem valores financeiros.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limite": {
              "default": 50,
              "description": "Quantidade máxima de obras a retornar.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "listar_medicoes",
        "title": "Consultar medições de uma obra",
        "description": "Consulta até 100 medições não excluídas de uma obra permitida, com número, período, origem e status, sem valores ou arquivos privados.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "obra_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identificador da obra retornado por listar_obras."
            },
            "limite": {
              "default": 50,
              "description": "Quantidade máxima de medições a retornar.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "obra_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
